+def _smin(a: float, b: float, p: float = 6.0) -> float:
+    """Myk minimumsfunksjon for positive tall: ingen knekk langs skroget der
+    grensen tar over."""
+    if a <= 0.0 or b <= 0.0:
+        return max(min(a, b), 0.0)
+    return (a ** -p + b ** -p) ** (-1.0 / p)
