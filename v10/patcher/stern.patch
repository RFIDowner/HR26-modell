+def _hermite(p0, t0, p1, t1, n):
+    """Kubisk Hermite-kurve fra p0 (retning t0) til p1 (retning t1)."""
+    L = float(np.linalg.norm(p1 - p0))
+    s = np.linspace(0.0, 1.0, n)[:, None]
+    h00 = 2 * s ** 3 - 3 * s ** 2 + 1
+    h10 = s ** 3 - 2 * s ** 2 + s
+    h01 = -2 * s ** 3 + 3 * s ** 2
+    h11 = s ** 3 - s ** 2
+    return h00 * p0 + h10 * L * t0 + h01 * p1 + h11 * L * t1
+
